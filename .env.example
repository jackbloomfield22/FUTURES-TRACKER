# Server-side only. Set these in Vercel > Project > Settings > Environment Variables.

# Injected automatically when you connect a Marketplace Redis database
# (Storage tab > Create Database > Redis). Shown here for local `vercel dev`.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Free key from https://the-odds-api.com (500 credits/month is plenty:
# responses cache in Redis for 6 hours).
ODDS_API_KEY=

# Anthropic key for slip parsing, edge checks, market checks
# (ANTHROPIC_API_KEY preferred; CLAUDE_API_KEY also accepted)
ANTHROPIC_API_KEY=
